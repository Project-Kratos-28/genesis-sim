      </geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.115" length="0.080"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0"
               iyy="0.010" iyz="0"
               izz="0.006"/>
    </inertial>
  </link>

  <joint name="wheel_front_left_spin" type="continuous">
    <parent link="steer_coupler_front_left"/>
    <child  link="wheel_front_left"/>
    <origin xyz="0.0 0.0 -0.186" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.05"/>
      <limit upper="3.14" velocity="10.0" effort="100.0"/>
  </joint>


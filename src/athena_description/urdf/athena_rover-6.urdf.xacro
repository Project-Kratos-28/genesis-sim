      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="-0.2600 1.0250 -0.0645" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://athena_description/meshes/collision/bogey_arm.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <origin xyz="0.0 -0.275 0.0" rpy="0 0 0"/>

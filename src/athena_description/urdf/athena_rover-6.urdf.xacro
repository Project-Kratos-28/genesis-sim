      </geometry>
      <material name="motor_grey"/>
    </visual>
    <collision>
      <origin xyz="0.6145 -1.1306 -0.1077" rpy="0 0 3.1416"/>
      <geometry>
        <mesh filename="package://athena_description/meshes/collision/SteeringMotorHousing.stl"
              scale="0.001 0.001 0.001"/>

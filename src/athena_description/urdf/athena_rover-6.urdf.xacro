<?xml version="1.0"?>
<!-- Athena Rover URDF v3 with STL mesh references. Generated from Athena.step. -->
<!-- All meshes exported in mm; scale="0.001 0.001 0.001" converts to metres.   -->
<!-- Package path: package://athena_description/meshes/                          -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="athena_rover">

  <xacro:include filename="$(find zed_wrapper)/urdf/zed_macro.urdf.xacro"/>

  <xacro:zed_camera name="zed2i" model="zed2i" enable_gnss="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:zed_camera>

  <material name="aluminium">
    <color rgba="0.75 0.75 0.80 1.0"/>
  </material>
  <material name="rubber">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="motor_grey">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>
  <material name="tpu_orange">
    <color rgba="0.9 0.45 0.1 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0.0 0.0 0.155" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.2600 0.7500 -0.0850" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://athena_description/meshes/visual/chassis.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="-0.2600 0.7500 -0.0850" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://athena_description/meshes/collision/chassis.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <inertia ixx="0.400" ixy="0.0" ixz="0.0"
               iyy="0.180" iyz="0.0"
               izz="0.500"/>
    </inertial>
  </link>

  <joint name="zed2i_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed2i_camera_link"/>
    <origin xyz="0.2 0 0.3" rpy="0 0 0"/>
  </joint>

  <link name="bogey_left">
    <visual>
      <origin xyz="-0.2600 -1.0250 0.0645" rpy="0 3.1416 3.1416"/>
      <geometry>
        <mesh filename="package://athena_description/meshes/visual/bogey_arm.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="-0.2600 -1.0250 0.0645" rpy="0 3.1416 3.1416"/>
      <geometry>
        <mesh filename="package://athena_description/meshes/collision/bogey_arm.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <origin xyz="0.0 0.275 0.0" rpy="0 0 0"/>
      <inertia ixx="0.030" ixy="0.0" ixz="0.0"
               iyy="0.002" iyz="0.0"
               izz="0.030"/>
    </inertial>
  </link>

  <joint name="bogey_left_pivot" type="revolute">
    <parent link="base_link"/>
    <child  link="bogey_left"/>
    <origin xyz="0.0 0.275 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5236" upper="0.5236" effort="0" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="bogey_right">
    <visual>
      <origin xyz="-0.2600 1.0250 -0.0645" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://athena_description/meshes/visual/bogey_arm.stl"
